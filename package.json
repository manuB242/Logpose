{
  "name": "logpose",
  "version": "0.1.0",
  "private": true,
  "description": "MVP de LogPose — orientation scolaire et professionnelle au Congo.",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "node apps/api/src/server.js",
    "dev:web": "vite --host 0.0.0.0 --config apps/web/vite.config.ts",
    "build": "tsc --project apps/web/tsconfig.json && vite build --config apps/web/vite.config.ts",
    "preview": "vite preview --host 0.0.0.0 --config apps/web/vite.config.ts"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  }
}
